{
  "expo": {
    "name": "TennisScoring",
    "slug": "tennis-scoring-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tennis-scoring-android",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#f4f1e8",
      "image": "./assets/images/launch-splash.png",
      "imageWidth": 340,
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#214b3a"
      },
      "package": "com.tennisscoringandroid"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/launch-splash.png",
          "imageWidth": 340,
          "resizeMode": "contain",
          "backgroundColor": "#f4f1e8"
        }
      ],
      "./plugins/withBrandingCheck"
    ],
    "autolinking": {
      "searchPaths": [
        "../../node_modules",
        "./node_modules"
      ]
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
